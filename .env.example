# Razorpay TEST MODE credentials only. Never put live-mode keys in this demo.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Create this webhook secret in the Razorpay test-mode dashboard. It is not the
# same value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_test_webhook_secret

# Safe default. Set to true, or pass `--live-api`, only for a deliberate test.
LIVE_API_MODE=false

# OpenAI API key for LLM-backed root-cause reasoning (optional).
# When set, the correlator and skeptic use real LLM calls; when absent,
# they fall back to deterministic rule-based logic.
OPENAI_API_KEY=
# Cost-efficient model. Override if needed (e.g. gpt-4.1-nano for cheaper).
OPENAI_MODEL=gpt-4.1-mini
